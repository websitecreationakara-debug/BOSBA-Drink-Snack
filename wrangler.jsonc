{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bosba-drink-snack",
  "compatibility_date": "2025-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "main": "src/server.ts",
  "workers_dev": false,
  "routes": [
    { "pattern": "bosbadrinksnack.com", "custom_domain": true },
    { "pattern": "www.bosbadrinksnack.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bosba-drink-snack",
      "database_id": "8c9071e1-c1ce-4649-8b53-a05a8a0c50d5",
      "migrations_dir": "drizzle/migrations"
    }
  ],
  "vars": {
    // Cross-site security dashboard ingest endpoint (see src/lib/audit.ts).
    // Not a secret, just a URL — the shared token is set via `wrangler secret put`.
    "SECURITY_EVENTS_URL": "https://todo-list-drab-ten.vercel.app/api/security-events"
  }
}
